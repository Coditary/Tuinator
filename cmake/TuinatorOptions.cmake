if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    set(TUINATOR_STANDALONE_PROJECT ON)
else()
    set(TUINATOR_STANDALONE_PROJECT OFF)
endif()

option(TUINATOR_BUILD_SHARED_LIBS "Build Tuinator as a shared library" OFF)
option(TUINATOR_BUILD_TESTS "Build unit tests" ${TUINATOR_STANDALONE_PROJECT})
option(TUINATOR_BUILD_EXAMPLES "Build example programs" ${TUINATOR_STANDALONE_PROJECT})
option(TUINATOR_INSTALL "Generate install rules" ${TUINATOR_STANDALONE_PROJECT})

if(TUINATOR_BUILD_SHARED_LIBS)
    set(TUINATOR_LIBRARY_TYPE SHARED)
else()
    set(TUINATOR_LIBRARY_TYPE STATIC)
endif()

# Test IDs are stored on widgets for AppDriver/CI. Stripped in Release by default.
set(_TUINATOR_TEST_IDS_DEFAULT ON)
if(CMAKE_BUILD_TYPE MATCHES "^(Release|MinSizeRel)$")
    set(_TUINATOR_TEST_IDS_DEFAULT OFF)
endif()
if(TUINATOR_BUILD_TESTS)
    set(_TUINATOR_TEST_IDS_DEFAULT ON)
endif()
option(TUINATOR_ENABLE_TEST_IDS "Store widget test IDs (set_test_id)" ${_TUINATOR_TEST_IDS_DEFAULT})
