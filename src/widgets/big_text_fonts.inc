inline const FigletFont* figlet_font(std::string_view id) {
  if (id == "slant") return &kFont_slant;
  if (id == "standard") return &kFont_standard;
  if (id == "small") return &kFont_small;
  if (id == "big") return &kFont_big;
  if (id == "doom") return &kFont_doom;
  if (id == "shadow") return &kFont_shadow;
  return nullptr;
}

